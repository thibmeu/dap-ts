{
  "name": "@thibmeu/dap",
  "version": "0.1.0",
  "description": "Distributed Aggregation Protocol (DAP) and Prio3 VDAFs in TypeScript",
  "keywords": [
    "dap",
    "vdaf",
    "prio",
    "prio3",
    "ppm",
    "privacy",
    "aggregation",
    "hpke"
  ],
  "author": "Thibault Meunier",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thibmeu/dap-ts.git"
  },
  "bugs": {
    "url": "https://github.com/thibmeu/dap-ts/issues"
  },
  "homepage": "https://github.com/thibmeu/dap-ts#readme",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./messages": {
      "types": "./dist/messages.d.ts",
      "default": "./dist/messages.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json && tsc -p tsconfig.bench.json",
    "test": "vitest run",
    "test:janus": "test/janus.sh",
    "lint": "biome check src test bench",
    "format": "biome format --write src test bench",
    "bench": "npm run build && node bench/count.ts",
    "bench:aggregator": "npm run build && node --expose-gc bench/aggregator.ts"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "hpke": "1.1.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@types/node": "26.6.3",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
