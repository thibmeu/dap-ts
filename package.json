{
  "name": "dap-ts",
  "version": "0.0.0",
  "private": true,
  "description": "Distributed Aggregation Protocol in TypeScript",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./messages": {
      "types": "./dist/messages.d.ts",
      "default": "./dist/messages.js"
    },
    "./collector": {
      "types": "./dist/collector.d.ts",
      "default": "./dist/collector.js"
    },
    "./aggregator": {
      "types": "./dist/aggregator.d.ts",
      "default": "./dist/aggregator.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:janus": "test/janus.sh",
    "lint": "biome check src test",
    "format": "biome format --write src test",
    "bench": "npm run build && node bench/count.mjs",
    "bench:aggregator": "npm run build && node --expose-gc bench/aggregator.mjs"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "hpke": "1.1.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
